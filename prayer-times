#!/usr/bin/env bash
# prayer-times: next-prayer widget for the Omarchy bar (type "command" module).
#
#   prayer-times             one-line JSON for the bar: next prayer, time, countdown
#   prayer-times --notify    show today's timetable as a desktop notification
#   prayer-times --table     print the timetable in the terminal
#   prayer-times --refresh   drop cached times/location and fetch again
#
# Times come from the Aladhan API (https://aladhan.com/prayer-times-api) and are
# cached per day, so the network is hit at most about twice a day. With no
# LATITUDE/LONGITUDE in the config, the location is auto-detected from
# https://geo.omarchy.org/ (the same lookup the weather widget uses).
#
# Config (optional): ~/.config/omarchy/prayer.conf, see that file for keys.

set -u
export LC_ALL=C

CONF="${PRAYER_CONF:-$HOME/.config/omarchy/prayer.conf}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-prayer"
API="https://api.aladhan.com/v1/timings"
GEO="https://geo.omarchy.org/"
PRAYERS=(Fajr Dhuhr Asr Maghrib Isha)
SHOWN=(Fajr Sunrise Dhuhr Asr Maghrib Isha)
ICON=$'\xef\x86\x86' # nf-fa-moon_o (U+F186), a crescent in the bar's Nerd Font
RETRY_AFTER=300 # seconds to wait after a failed request

LATITUDE="" LONGITUDE="" CITY="" METHOD="" SCHOOL=""
ALERT_MINUTES=15 TIME_FORMAT=24
HIJRI_CALENDAR=UAQ JUMUAH_REMINDER=30

MODE=bar
case "${1:-}" in
  --json) MODE=json ;;
  --jumuah) MODE=jumuah ;;
  --notify) MODE=notify ;;
  --table) MODE=table ;;
  --refresh) MODE=refresh ;;
  "") ;;
  *) echo "usage: ${0##*/} [--json|--jumuah|--notify|--table|--refresh]" >&2; exit 2 ;;
esac

mkdir -p "$CACHE"

# ---- helpers ---------------------------------------------------------------

fail() {
  case $MODE in
    json) jq -nc --arg e "$1" '{ok: false, error: $e}' ;;
    bar) jq -nc --arg t "$1" --arg i "$ICON" '{text: ($i + " --"), tooltip: $t, class: "error"}' ;;
    notify) notify-send -a "Prayer times" "Prayer times unavailable" "$1" ;;
    *) echo "$1" >&2 ;;
  esac
  exit 0
}

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf %s "$s"
}

net_blocked() {
  local f="$CACHE/.fail"
  [ -f "$f" ] && (( $(date +%s) - $(stat -c %Y "$f") < RETRY_AFTER ))
}
net_failed() { touch "$CACHE/.fail"; }

load_config() {
  [ -r "$CONF" ] || return 0
  local key val
  while IFS='=' read -r key val || [ -n "$key" ]; do
    key=$(trim "$key")
    case $key in '' | \#*) continue ;; esac
    val=$(trim "${val%%#*}")
    val=${val#\"}; val=${val%\"}
    case $key in
      LATITUDE | LONGITUDE) [[ $val =~ ^-?[0-9]+(\.[0-9]+)?$ ]] && printf -v "$key" %s "$val" ;;
      METHOD) [[ $val =~ ^[0-9]{1,2}$ ]] && METHOD=$val ;;
      SCHOOL) [[ $val == 0 || $val == 1 ]] && SCHOOL=$val ;;
      ALERT_MINUTES) [[ $val =~ ^[0-9]{1,3}$ ]] && ALERT_MINUTES=$val ;;
      TIME_FORMAT) [[ $val == 12 || $val == 24 ]] && TIME_FORMAT=$val ;;
      HIJRI_CALENDAR) [[ $val =~ ^(UAQ|HJCoSA|DIYANET|MATHEMATICAL)$ ]] && HIJRI_CALENDAR=$val ;;
      JUMUAH_REMINDER) [[ $val =~ ^[0-9]{1,3}$ ]] && JUMUAH_REMINDER=$val ;;
      CITY) CITY=${val:0:40} ;;
    esac
  done < "$CONF"
}

read -r -d '' GEO_FILTER <<'EOF'
select((.latitude | type) == "number" and (.longitude | type) == "number"
       and (.latitude >= -90 and .latitude <= 90) and (.longitude >= -180 and .longitude <= 180))
| {
    name: ((.name // "") | tostring | gsub("[^\\p{L}\\p{M}0-9 .,'’-]"; "") | .[0:40]
           | if . == "" then "Your location" else . end),
    latitude, longitude
  }
EOF

read -r -d '' DAY_FILTER <<'EOF'
select(.code == 200)
| .data as $d
| {
    tz: ($d.meta.timezone // ""),
    method: (($d.meta.method.name // "") | tostring | gsub("[^\\p{L}\\p{M}0-9 .,()-]"; "") | .[0:60]),
    t: ($d.timings | {Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha} | map_values(tostring | .[0:5]))
  }
| select(.tz | test("^[A-Za-z0-9_+/-]{1,40}$"))
| select(all(.t[]; test("^([01][0-9]|2[0-3]):[0-5][0-9]$")))
| .hijri = ((try (
    $d.date.hijri | {day: (.day | tonumber), month: (.month.number | tonumber), year: (.year | tonumber)}
    | select(.day >= 1 and .day <= 30 and .month >= 1 and .month <= 12 and .year >= 1300 and .year <= 1700)
  ) catch null) // null)
EOF

# Sets PLACE, LATITUDE, LONGITUDE.
resolve_location() {
  if [ -n "$LATITUDE" ] && [ -n "$LONGITUDE" ]; then
    PLACE=${CITY:-"$LATITUDE, $LONGITUDE"}
    return 0
  fi

  local f="$CACHE/location.json" raw
  if [ ! -s "$f" ] || (( $(date +%s) - $(stat -c %Y "$f") > 604800 )); then
    if ! net_blocked; then
      if raw=$(curl -fsS --max-time 4 --max-filesize 4096 "$GEO") \
        && jq -ce "$GEO_FILTER" <<<"$raw" > "$f.tmp" 2>/dev/null && [ -s "$f.tmp" ]; then
        mv "$f.tmp" "$f"
      else
        rm -f "$f.tmp"
        net_failed
      fi
    fi
  fi
  [ -s "$f" ] || return 1

  IFS=$'\t' read -r PLACE LATITUDE LONGITUDE < <(jq -r '[.name, .latitude, .longitude] | @tsv' "$f")
  [[ ${LATITUDE:-} =~ ^-?[0-9]+(\.[0-9]+)?$ && ${LONGITUDE:-} =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || return 1
  [ -n "$CITY" ] && PLACE=$CITY
  return 0
}

day_file() { printf '%s/%s_%s.json' "$CACHE" "$KEY" "$1"; }

# Make sure the cache holds the given day (YYYY-MM-DD, location time).
ensure_day() {
  local d=$1 f raw url
  f=$(day_file "$d")
  [ -s "$f" ] && return 0
  net_blocked && return 1

  url="$API/${d:8:2}-${d:5:2}-${d:0:4}?latitude=$LATITUDE&longitude=$LONGITUDE&calendarMethod=$HIJRI_CALENDAR"
  [ -n "$METHOD" ] && url+="&method=$METHOD"
  [ -n "$SCHOOL" ] && url+="&school=$SCHOOL"

  if raw=$(curl -fsS --max-time 8 --max-filesize 65536 "$url") \
    && jq -ce "$DAY_FILTER" <<<"$raw" > "$f.tmp" 2>/dev/null && [ -s "$f.tmp" ] \
    && [ -e "/usr/share/zoneinfo/$(jq -r .tz "$f.tmp")" ]; then
    mv "$f.tmp" "$f"
    jq -r .tz "$f" > "$CACHE/$KEY.tz"
    find "$CACHE" -name '*_????-??-??.json' -mtime +7 -delete 2>/dev/null
    return 0
  fi
  rm -f "$f.tmp"
  net_failed
  return 1
}

location_tz() {
  local tz=""
  [ -s "$CACHE/$KEY.tz" ] && tz=$(< "$CACHE/$KEY.tz")
  if [ -z "$tz" ] || [ ! -e "/usr/share/zoneinfo/$tz" ]; then
    tz=$(readlink /etc/localtime 2>/dev/null)
    tz=${tz#*/zoneinfo/}
  fi
  printf %s "$tz"
}

declare -A T=()
METHOD_NAME=""

# Fill T[] (and METHOD_NAME) from the cached day.
load_day() {
  local f k v
  f=$(day_file "$1")
  T=()
  while IFS=$'\t' read -r k v; do T[$k]=$v; done < <(jq -r '.t | to_entries[] | [.key, .value] | @tsv' "$f")
  METHOD_NAME=$(jq -r .method "$f")
}

fmt_time() {
  if [ "$TIME_FORMAT" = 12 ]; then date -d "$1" +'%-I:%M %p'; else printf %s "$1"; fi
}

epoch_of() { TZ=$TZ_LOC date -d "$1 $2" +%s; }

# ---- main ------------------------------------------------------------------

load_config

if [ "$MODE" = refresh ]; then
  rm -f "$CACHE"/*.json "$CACHE"/*.tz "$CACHE"/.fail
fi

resolve_location || fail "Could not work out your location (offline?). Set LATITUDE and LONGITUDE in $CONF"
KEY="v2_${LATITUDE}_${LONGITUDE}_${METHOD:-auto}_${SCHOOL:-auto}_${HIJRI_CALENDAR}"

# The first fetch teaches us the location's time zone; a second pass fixes "today"
# if that zone's date differs from the system's.
TZ_LOC=$(location_tz)
today=$(TZ=$TZ_LOC date +%F)
ensure_day "$today"
TZ_LOC=$(location_tz)
today=$(TZ=$TZ_LOC date +%F)
ensure_day "$today" || fail "Prayer times unavailable (offline?). Will retry shortly."

load_day "$today"
now=$(date +%s)

NEXT_NAME="" NEXT_EPOCH="" LIST_DAY=$today APPROX=""
for p in "${PRAYERS[@]}"; do
  e=$(epoch_of "$today" "${T[$p]}")
  if (( e > now )); then NEXT_NAME=$p NEXT_EPOCH=$e; break; fi
done

if [ -z "$NEXT_NAME" ]; then
  # Past Isha: the next prayer is tomorrow's Fajr.
  tomorrow=$(TZ=$TZ_LOC date -d "$today +1 day" +%F)
  if ensure_day "$tomorrow"; then
    load_day "$tomorrow"
    LIST_DAY=$tomorrow
  else
    APPROX="~" # fall back to today's Fajr time, one day on
  fi
  NEXT_NAME=Fajr
  NEXT_EPOCH=$(epoch_of "$tomorrow" "${T[Fajr]}")
fi

remaining=$(( (NEXT_EPOCH - now + 59) / 60 ))
if (( remaining >= 60 )); then countdown="$((remaining / 60))h $((remaining % 60))m"; else countdown="${remaining}m"; fi

table=""
for n in "${SHOWN[@]}"; do
  mark="  "; [ "$n" = "$NEXT_NAME" ] && mark="▶ "
  table+=$(printf '%s%-8s %s' "$mark" "$n" "$(fmt_time "${T[$n]}")")$'\n'
done
table=${table%$'\n'}

heading="$PLACE"
[ "$LIST_DAY" != "$today" ] && heading+=" (tomorrow)"

# JSON for the Jumu'ah reminder window, or "null" when there is none today:
# it needs a Friday, today's own times (not tomorrow's) and a reminder lead > 0.
jumuah_spec() {
  if [ "$LIST_DAY" = "$today" ] && [ "$(TZ=$TZ_LOC date -d "$today" +%u)" = 5 ] && (( JUMUAH_REMINDER > 0 )); then
    jq -nc --argjson e "$(epoch_of "$today" "${T[Dhuhr]}")" --argjson m "$JUMUAH_REMINDER" '{epoch: $e, leadMinutes: $m}'
  else
    echo null
  fi
}

case $MODE in
  json)
    # Structured data for the bar widget (plugin Panel.qml). Epochs are seconds.
    rows=""
    for n in "${SHOWN[@]}"; do
      rows+=$(printf '%s\t%s\t%s' "$n" "$(epoch_of "$LIST_DAY" "${T[$n]}")" "$(fmt_time "${T[$n]}")")$'\n'
    done
    jq -nc --arg rows "${rows%$'\n'}" --arg place "$PLACE" --arg method "$METHOD_NAME" \
      --arg next "$NEXT_NAME" --arg nextTime "$(fmt_time "${T[$NEXT_NAME]}")" --argjson nextEpoch "$NEXT_EPOCH" \
      --arg tomorrow "$([ "$LIST_DAY" != "$today" ] && echo 1)" --arg approx "$APPROX" --argjson alert "$ALERT_MINUTES" \
      --arg date "$LIST_DAY" --arg friday "$([ "$(TZ=$TZ_LOC date -d "$LIST_DAY" +%u)" = 5 ] && echo 1)" \
      --argjson hijri "$(jq -c .hijri "$(day_file "$LIST_DAY")")" --argjson jumuah "$(jumuah_spec)" '
      {
        ok: true, place: $place, method: $method, date: $date,
        tomorrow: ($tomorrow == "1"), approx: ($approx != ""), alertMinutes: $alert,
        friday: ($friday == "1"), hijri: $hijri, jumuah: $jumuah,
        next: {name: $next, time: $nextTime, epoch: $nextEpoch},
        prayers: ($rows | split("\n") | map(split("\t") | {name: .[0], epoch: (.[1] | tonumber), time: .[2], prayer: (.[0] != "Sunrise")}))
      }'
    ;;
  jumuah)
    # Called by the widget once the reminder window opens; safe to call again,
    # it sends at most one notification per Friday.
    [ "$(jumuah_spec)" != null ] || exit 0
    dhuhr=$(epoch_of "$today" "${T[Dhuhr]}")
    (( now >= dhuhr - JUMUAH_REMINDER * 60 && now < dhuhr )) || exit 0
    sent="$CACHE/jumuah-sent-$today"
    ( set -o noclobber; : > "$sent" ) 2>/dev/null || exit 0 # atomic: first caller wins
    notify-send -a "Prayer times" -u normal -t 15000 "Jumu'ah Mubarak" \
      "Dhuhr (Jumu'ah) is at $(fmt_time "${T[Dhuhr]}") in $PLACE, in $(( (dhuhr - now + 59) / 60 )) min."
    find "$CACHE" -name 'jumuah-sent-*' -mtime +7 -delete 2>/dev/null
    ;;
  notify)
    notify-send -a "Prayer times" -t 10000 "Prayer times · $heading" "$table"$'\n'"$METHOD_NAME"
    ;;
  table | refresh)
    printf '%s\n%s\n%s\n' "$heading" "$table" "$METHOD_NAME"
    ;;
  bar)
    class=""
    (( ALERT_MINUTES > 0 && remaining <= ALERT_MINUTES )) && class="active"
    jq -nc \
      --arg text "$ICON $NEXT_NAME $APPROX$(fmt_time "${T[$NEXT_NAME]}") · $countdown" \
      --arg tooltip "$ICON $heading"$'\n'"$table"$'\n'"$METHOD_NAME" \
      --arg class "$class" \
      '{text: $text, tooltip: $tooltip, class: $class}'
    ;;
esac
